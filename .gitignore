# Adapted from sear-labs/code-standard/gitignore-starter.
# Verify, don't assume:  git check-ignore -v <path>

# --- credentials: the one mistake that cannot be undone -----------------
.env
.env.*
*.lic
gamslice.txt
gamslice*.txt
*license.dat
*licence.dat
WLSKeyinfo*
*.pem
*.key
*_key*
*_secret*
*credentials*
*token*
service-account*.json

# --- data: raw kept OUT by default -------------------------------------
data/raw/*
data/interim/*
data/processed/*
!data/**/.gitkeep
# Deliberate exception: the 3-region instance tables are small, immutable,
# and cleared for this private repo (standard Part 1 rule 4). Un-ignored:
!data/raw/input_data_3region/

# --- generated results -------------------------------------------------
results/*
!results/figures/
!results/tables/
!results/**/.gitkeep

# --- python ----------------------------------------------------------
__pycache__/
*.py[cod]
.ipynb_checkpoints/
*.egg-info/
build/
dist/
.venv/
venv/
.pytest_cache/
.ruff_cache/

# --- models and large artifacts --------------------------------------
*.ckpt
*.pt
*.pth
*.h5
*.onnx

# --- notebook run artifacts (belong in results/ once the model settles) ---
/notebooks/*.xlsx
/*.xlsx

# --- solver / tool noise --------------------------------------------
*.log
*.lp
*.mps
*.sol
*.ilp

# --- editor backups -------------------------------------------------
*.bak
*.orig
*~

# --- os / editor ---------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
