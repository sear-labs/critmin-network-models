# Adapted from sear-labs/code-standard/gitignore-starter.
# Verify, don't assume:  git check-ignore -v <path>

# --- credentials: the one mistake that cannot be undone -----------------
.env
.env.*
*.lic
gamslice.txt
gamslice*.txt
*license.dat
*licence.dat
WLSKeyinfo*
*.pem
*.key
*_key*
*_secret*
*credentials*
*token*
service-account*.json

# --- data: raw kept OUT by default -------------------------------------
data/raw/*
data/interim/*
data/processed/*
!data/**/.gitkeep
# Deliberate exception: small, cleared instance tables for this private
# repo (standard Part 1 rule 4). Un-ignored:
!data/raw/import_data/
!data/raw/critical_mineral_production/
!data/raw/friendshoring/
# NOT un-ignored on purpose: a 192MB Lens.org patent-database export
# (lfp-0525-granted.csv) exceeds GitHub's file-size limits and its
# redistribution terms weren't checked -- see README/PROJECT_JOURNAL.

# --- generated results -------------------------------------------------
results/*
!results/figures/
!results/tables/
!results/**/.gitkeep

# --- notebook run artifacts ---------------------------------------------
/notebooks/*.xlsx
/*.xlsx
/notebooks/commodity_plots/

# --- python ----------------------------------------------------------
__pycache__/
*.py[cod]
.ipynb_checkpoints/
*.egg-info/
build/
dist/
.venv/
venv/
.pytest_cache/
.ruff_cache/

# --- models and large artifacts --------------------------------------
*.ckpt
*.pt
*.pth
*.h5
*.onnx

# --- solver / tool noise --------------------------------------------
*.log
*.lp
*.mps
*.sol
*.ilp

# --- editor backups -------------------------------------------------
*.bak
*.orig
*~

# --- os / editor ---------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
